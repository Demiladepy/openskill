# CoinMarketCap Data API (required for Track 2)
CMC_API_KEY=your_cmc_pro_api_key
CMC_USE_MOCK=0
CMC_MIN_REQUEST_INTERVAL_MS=2000

# CMC Agent Hub MCP (Best Use of CMC Data & Signal prize)
MCP_ENABLED=0
# MCP_ENABLED=1
# CMC_MCP_URL=https://mcp.coinmarketcap.com/mcp

# BNB Chain + TWAK attestation (BSC testnet — self-custody signing)
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
CMC_STRATEGY_VAULT_CONTRACT=0x_deployed_contract_address

TWAK_UNLOCK_PASSPHRASE=your_unlock_passphrase
TWAK_AGENT_PRIVATE_KEY=0x_optional_agent_wallet_key
AGENT_PRIVATE_KEY=0x_your_bsc_testnet_private_key
TWAK_SESSION_PATH=~/.twak/session.json
ATTEST_MODE=live
# ATTEST_MODE=simulate  # CI / offline demo only

# Backtest window (build period)
CMC_BACKTEST_FROM=2026-06-01
CMC_BACKTEST_TO=2026-06-21
REPLAY_FROM=2026-06-01
REPLAY_TO=2026-06-28
# Shared behavior log
# CMC_STRATEGY_VAULT_LOG=~/.config/cmc-strategy-forge/behavior-log.jsonl

# CMC Strategy Forge — environment variables
# Copy to skill-reputation/.env (never commit .env)

# ── CoinMarketCap ─────────────────────────────────────────────
# Get key: https://pro.coinmarketcap.com/account
CMC_API_KEY=your_api_key_from_pro.coinmarketcap.com
CMC_USE_MOCK=0
CMC_MIN_REQUEST_INTERVAL_MS=2000

# Note: Helius is Solana-only — not used in this BNB/BSC Track 2 project.
# For on-chain txs use BNB_RPC_URL (public BSC testnet RPC below, or Alchemy/QuickNode BSC testnet if you prefer).

# ── MCP (optional — enhances CMC integration) ───────────────
MCP_ENABLED=0
# MCP_ENABLED=1
# CMC_MCP_URL=https://mcp.coinmarketcap.com/mcp

# ── Trust Wallet Agent Kit (TWAK) ─────────────────────────────
# Install: npm install -g @trustwallet/cli
# Or: curl -fsSL https://agent-kit.trustwallet.com/install.sh | bash
# Credentials: https://portal.trustwallet.com/dashboard/apps
# Setup: twak setup
TWAK_ENABLED=1
# MCP for agents: twak serve (see twak-mcp-config.json)

# ── Attestation (BSC Testnet — TWAK-compatible signing) ─────
ATTEST_MODE=live
# Trust Wallet users: paste recovery phrase here OR export BSC testnet private key
# AGENT_MNEMONIC=word1 word2 word3 ...
AGENT_PRIVATE_KEY=your_bsc_testnet_private_key
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
# Optional vault contract; omit to use self-send attestation tx
# CMC_STRATEGY_VAULT_CONTRACT=0x...

TWAK_UNLOCK_PASSPHRASE=your_unlock_passphrase
TWAK_AGENT_PRIVATE_KEY=0x_optional_same_as_agent_private_key
TWAK_SESSION_PATH=~/.twak/session.json

# ── BNB Agent SDK (optional — ERC-8004 registration) ────────
AGENT_SIMULATE=0
# AGENT_DISCOVERY_MODE=github
# AGENT_REPO_URL=https://github.com/Demiladepy/openskill
# AGENT_DOCS_URL=https://github.com/Demiladepy/openskill
# Optional later (Render): AGENT_PUBLIC_URL=https://YOUR-SERVICE.onrender.com/erc8183/status

# ── Backtest window ─────────────────────────────────────────
CMC_BACKTEST_FROM=2026-03-01
CMC_BACKTEST_TO=2026-06-01
REPLAY_FROM=2026-03-01
REPLAY_TO=2026-06-28

# ── Audit log (optional, not part of judge demo) ─────────────
# CMC_STRATEGY_FORGE_LOG=~/.config/cmc-strategy-forge/behavior-log.jsonl

# BNB AI Agent SDK — copy to bnbagent/.env.agent (never commit real keys)

NETWORK=bsc-testnet
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Live mode: set AGENT_PRIVATE_KEY (BSC testnet throwaway wallet)
AGENT_SIMULATE=0
CMC_USE_MOCK=1

# Agent identity (ERC-8004)
AGENT_PRIVATE_KEY=0x_your_bsc_testnet_private_key
WALLET_PASSWORD=local-dev-only
AGENT_NAME=CMC Strategy Forge
AGENT_DESCRIPTION=Backtestable quant strategy agent powered by CoinMarketCap data
AGENT_PUBLIC_URL=http://localhost:8000/erc8183/status
# When Render is up: https://YOUR-SERVICE.onrender.com/erc8183/status
AGENT_FALLBACK_URL=http://localhost:8000/erc8183/status
AGENT_DOCS_URL=
# Vercel docs UI URL for ERC-8004 agentURI "docs" endpoint
FORGE_MCP_CONFIG_URL=https://github.com/Demiladepy/openskill/raw/main/skill-reputation/forge-mcp-config.json
AGENT_SKILLS_URL=https://github.com/Demiladepy/openskill/tree/main/skill-reputation/skills
SKILL_INSTALL_CMD=npx skills add https://github.com/Demiladepy/openskill/tree/main/skill-reputation/skills
# After npm run attest — paste BscScan URL here before re-register
# ATTESTATION_EXPLORER_URL=https://testnet.bscscan.com/tx/0x...

# After registration (filled by register_agent.py)
# AGENT_ID=42
# AGENT_PROVIDER_ADDRESS=0x...

# Client wallet (ERC-8183 job poster — optional stretch goal)
# CLIENT_PRIVATE_KEY=0x...

# Official BSC Testnet contracts (bnbagent SDK defaults)
ERC8004_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8183_COMMERCE_ADDRESS=0xa206c0517b6371c6638cd9e4a42cc9f02a33b0de
ERC8183_ROUTER_ADDRESS=0xd7d36d66d2f1b608a0f943f722d27e3744f66f25
ERC8183_POLICY_ADDRESS=0x4f4678d4439fec812ac7674bb3efb4c8f5fb78a6

# Agent server
AGENT_PORT=8000
AGENT_SERVER_URL=http://localhost:8000
ERC8183_AGENT_URL=http://localhost:8000/erc8183
ERC8183_SERVICE_PRICE=1000000000000000000

# CMC data
CMC_API_KEY=

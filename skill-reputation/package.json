{
  "name": "cmc-strategy-forge",
  "version": "2.0.0",
  "private": true,
  "description": "CoinMarketCap-powered quant strategy skills for BNB Hackathon Track 2",
  "type": "module",
  "workspaces": [
    "skill",
    "backtest",
    "cli-skill"
  ],
  "scripts": {
    "strategy:all": "node strategies/index.js all --all",
    "strategy:momentum": "node strategies/index.js momentum --from 2026-03-01 --to 2026-06-01",
    "strategy:sentiment": "node strategies/index.js sentiment --from 2026-03-01 --to 2026-06-01",
    "strategy:regime": "node strategies/index.js regime --from 2026-03-01 --to 2026-06-01",
    "replay": "node replay/pnlReplay.js",
    "attest": "node skill/scripts/attest.js --strategy momentum --score 85",
    "export:skills": "node marketplace/exporter.js --from-scan",
    "verify": "node scripts/hackathonVerify.js",
    "registry": "npm run strategy:all",
    "hackathon:verify": "npm run verify",
    "twak:setup": "node skill/scripts/twakSetup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^7.0.1",
    "viem": "^2.52.2"
  }
}

{
  "name": "cmc-strategy-forge",
  "version": "2.0.0",
  "private": true,
  "description": "CoinMarketCap Strategy Forge — Track 2 backtestable strategy skills (simulation only).",
  "type": "module",
  "workspaces": [
    "contracts",
    "skill",
    "demo-ui",
    "backtest"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --test strategies/lib/indicators.test.js 2>/dev/null || true",
    "registry": "node src/skillRegistry.js",
    "strategy": "node strategies/index.js",
    "strategy:all": "node strategies/index.js all --all",
    "backtest": "node strategies/index.js momentum --from 2026-06-01 --to 2026-06-21",
    "replay": "node replay/pnlReplay.js",
    "export": "node marketplace/exporter.js",
    "export:scan": "node marketplace/exporter.js --from-scan",
    "validate": "node marketplace/validator.js",
    "hackathon:verify": "node scripts/hackathonVerify.js",
    "twak:setup": "node skill/scripts/twakSetup.js",
    "build:ui": "npm run build -w skill-reputation-demo-ui",
    "scan:cmc": "node skill/scripts/scan.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "viem": "^2.52.2"
  }
}
